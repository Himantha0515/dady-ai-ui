# Frontend-safe (Vite)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_RAZORPAY_KEY_ID=rzp_test_xxx
VITE_APP_URL=http://localhost:5173
VITE_MOCK_BACKEND=true

# Backend-only (Edge Functions / local secrets — NEVER prefix with VITE_)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

FAL_KEY=your-fal-key
FAL_WEBHOOK_SECRET=your-fal-webhook-secret

CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dady-media
R2_ENDPOINT=

# Redis intentionally omitted for this implementation

APP_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
APP_ENV=development
MOCK_PROVIDERS=true
